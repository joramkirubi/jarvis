# ============================================================
# ElevenLabs Configuration
# ============================================================

# Your ElevenLabs API key
# Get it from your ElevenLabs account/settings
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# The ElevenLabs Voice ID you want Jarvis to use
# Example: a voice ID copied from your ElevenLabs voice library
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here

# ElevenLabs text-to-speech model
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Audio output format used by Jarvis
ELEVENLABS_OUTPUT_FORMAT=pcm_24000


# ============================================================
# Jarvis Audio Configuration
# ============================================================

# Microphone/input device index
# Run your audio-device listing script to find the correct number
JARVIS_INPUT_DEVICE=your_microphone_device_number_here


# ============================================================
# External URLs
# ============================================================

# URL opened when launching the AI/chat service
CLAUDE_CODE_URL=https://chatgpt.com

# Replace with the URL you want Jarvis to open for Tasaradar
TASARADAR_URL=https://github.com/your_github_username

# Replace with the URL you want Jarvis to open for Binance/Bitcoin
BINANCE_BTC_URL=https://example.com